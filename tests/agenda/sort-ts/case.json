{
  "today": "2026-05-18",
  "now": "10:30",
  "runs": [
    {
      "view": "agenda",
      "span": "day"
    },
    {
      "view": "todo"
    },
    {
      "view": "tags",
      "match": "LEVEL>0"
    }
  ],
  "options": {
    "org_agenda_sorting_strategy": {
      "agenda": [
        "deadline-down",
        "scheduled-up",
        "category-keep"
      ],
      "todo": [
        "tsia-down"
      ],
      "tags": [
        "ts-up",
        "priority-down"
      ]
    },
    "org_agenda_sort_notime_is_late": false
  },
  "emacs": "(setq org-agenda-sorting-strategy '((agenda deadline-down scheduled-up category-keep) (todo tsia-down) (tags ts-up priority-down)) org-agenda-sort-notime-is-late nil)"
}