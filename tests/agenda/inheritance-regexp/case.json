{
  "today": "2026-10-05",
  "now": "10:30",
  "runs": [
    {
      "view": "agenda",
      "span": "week"
    },
    {
      "view": "todo"
    },
    {
      "view": "tags",
      "match": "proj"
    },
    {
      "view": "tags",
      "match": "office-crypt"
    },
    {
      "view": "tags",
      "match": "personal|outside"
    },
    {
      "view": "tags",
      "match": "OWNER=\"alice\""
    },
    {
      "view": "tags",
      "match": "OWNER=\"carol\""
    },
    {
      "view": "tags",
      "match": "OWNER={.}"
    },
    {
      "view": "tags",
      "match": "STAGE={review}"
    },
    {
      "view": "tags",
      "match": "COLOR=\"blue green\""
    },
    {
      "view": "tags",
      "match": "TEAM=\"core\""
    },
    {
      "view": "tags-todo",
      "match": "urgent|home"
    }
  ],
  "options": {
    "org_use_tag_inheritance": "^[a-o]",
    "org_tags_exclude_from_inheritance": [
      "crypt",
      "home"
    ],
    "org_use_property_inheritance": "^\\(?:color\\|team\\)$"
  },
  "emacs": "(setq org-use-tag-inheritance \"^[a-o]\" org-tags-exclude-from-inheritance '(\"crypt\" \"home\") org-use-property-inheritance \"^\\\\(?:color\\\\|team\\\\)$\")"
}
