{
  "description": "Filtering the TODO list by tag, category, regexp, effort and top headline, with the views Emacs printed for the same filters.",
  "files_from": "agenda/filters",
  "clock": { "today": "2026-10-05", "now": "10:30" },
  "options": { "org_global_properties": { "Effort_ALL": "0 0:10 0:30 1:00 2:00" } },
  "steps": [
    { "open": "work.org" },
    { "command": "org.agenda.dispatch", "answers": ["t"] },
    { "command": "org.agenda.filter", "answers": ["+home"], "expect": ["agenda", "messages"], "emacs": "agenda/filters/expected-19.txt" },
    { "command": "org.agenda.filter.remove", "expect": ["agenda", "messages"] },
    { "command": "org.agenda.filter", "answers": ["-home<1:00"], "expect": ["agenda"], "emacs": "agenda/filters/expected-20.txt" },
    { "command": "org.agenda.filter.remove" },
    { "command": "org.agenda.filter", "count": 4, "answers": ["+home"], "expect": ["agenda"], "emacs": "agenda/filters/expected-24.txt" },
    { "command": "org.agenda.filter.remove" },
    { "command": "org.agenda.filter.tag", "answers": ["\t", "home"], "expect": ["agenda", "messages"], "emacs": "agenda/filters/expected-0.txt" },
    { "command": "org.agenda.filter.tag", "answers": ["\\"], "expect": ["agenda", "messages"] },
    { "at": "Write report", "command": "org.agenda.filter.category", "expect": ["agenda", "messages"], "emacs": "agenda/filters/expected-8.txt" },
    { "command": "org.agenda.filter.category", "expect": ["agenda", "messages"] },
    { "command": "org.agenda.filter.regexp", "answers": ["the"], "expect": ["agenda", "messages"], "emacs": "agenda/filters/expected-11.txt" },
    { "command": "org.agenda.filter.regexp", "expect": ["messages"] },
    { "command": "org.agenda.filter.effort", "answers": ["<", "3"], "expect": ["agenda", "messages"], "emacs": "agenda/filters/expected-14.txt" },
    { "command": "org.agenda.filter.effort", "answers": ["_"], "expect": ["messages"] },
    { "at": "Write report", "command": "org.agenda.filter.top.headline", "expect": ["agenda", "messages"], "emacs": "agenda/filters/expected-17.txt" },
    { "command": "org.agenda.filter.top.headline", "expect": ["agenda", "messages"] }
  ]
}
