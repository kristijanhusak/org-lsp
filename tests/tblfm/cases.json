  }
 },
 {
  "name": "the last column on the left",
  "text": "| 1 | 2 |  |\n#+TBLFM: $>=$1+$2\n",
  "expected": {
   "text": "| 1 | 2 | 3 |\n#+TBLFM: $>=$1+$2\n"
  }
 },
 {
  "name": "the row before the last",
  "text": "| 1 |\n| 2 |\n|   |\n| 9 |\n#+TBLFM: @>>$1=@1+@2\n",
