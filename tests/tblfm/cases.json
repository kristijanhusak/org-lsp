   "text": "|---|\n| 1 |\n| 2 |\n|---|\n| 3 |\n#+TBLFM: @>$1=vsum(@I..@II)\n"
  }
 },
 {
  "name": "the row below",
  "text": "| 1 |  |\n| 2 |  |\n| 3 |  |\n#+TBLFM: @1$2..@2$2=@+1$1\n",
