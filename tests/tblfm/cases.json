   "text": "| 1 | 0 | 0 | 1 |\n#+TBLFM: $3=$1 && $2::$4=$1 || $2\n"
  }
 },
 {
  "name": "powers with floats and negative exponents",
  "text": "| 2 |  |  |\n#+TBLFM: $2=$1^0.5::$3=$1^-1\n",
