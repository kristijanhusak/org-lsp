   "text": "| 2 | 1.4142136 | 0.5 |\n#+TBLFM: $2=$1^0.5::$3=$1^-1\n"
  }
 },
 {
  "name": "durations: T writes HH:MM:SS",
  "text": "| 1:30 | 2:15 |  |\n| 0:45:30 | 10:20 |  |\n#+TBLFM: $3=$1+$2;T\n",
  "expected": {
   "text": "|    1:30 |  2:15 | 03:45:00 |\n| 0:45:30 | 10:20 | 11:05:30 |\n#+TBLFM: $3=$1+$2;T\n"
  }
 },
 {
  "name": "durations: U writes HH:MM",
  "text": "| 1:30 | 2:15 |  |\n#+TBLFM: $3=$1+$2;U\n",
  "expected": {
   "text": "| 1:30 | 2:15 | 03:45 |\n#+TBLFM: $3=$1+$2;U\n"
  }
 },
 {
  "name": "durations: t writes hours",
  "text": "| 1:30 | 2:15 |  |\n#+TBLFM: $3=$1+$2;t\n",
  "expected": {
   "text": "| 1:30 | 2:15 | 3.75 |\n#+TBLFM: $3=$1+$2;t\n"
  }
 },
 {
  "name": "durations: a sum of a column",
  "text": "| task | time |\n|------+------|\n| a | 1:30 |\n| b | 0:45 |\n| c | 2:10 |\n|------+------|\n| total |  |\n#+TBLFM: @>$2=vsum(@I..@II);T\n",
  "expected": {
   "text": "| task  |     time |\n|-------+----------|\n| a     |     1:30 |\n| b     |     0:45 |\n| c     |     2:10 |\n|-------+----------|\n| total | 04:25:00 |\n#+TBLFM: @>$2=vsum(@I..@II);T\n"
  }
 },
 {
  "name": "durations: negative and times numbers",
  "text": "| 1:30 | 2:15 |  |  |\n#+TBLFM: $3=$1-$2;T::$4=$1*2;U\n",
  "expected": {
   "text": "| 1:30 | 2:15 | -00:45:00 | 03:00 |\n#+TBLFM: $3=$1-$2;T::$4=$1*2;U\n"
  }
 },
 {
  "name": "durations: a plain number is seconds",
  "text": "| 90 | 3600 |  |\n#+TBLFM: $3=$1+$2;T\n",
  "expected": {
   "text": "| 90 | 3600 | 01:01:30 |\n#+TBLFM: $3=$1+$2;T\n"
  }
 },
 {
  "name": "durations: a single reference copies",
  "text": "| 1:30 |  |\n#+TBLFM: $2=$1;T\n",
  "expected": {
