 },
 {
  "name": "month weekday hour minute",
  "text": "| <2024-03-01 Fri 10:45> |  |  |  |  |\n#+TBLFM: $2=month($1)::$3=weekday($1)::$4=hour($1)::$5=minute($1)\n",
  "expected": {
   "text": "| <2024-03-01 Fri 10:45> | 3 | 5 | 10 | 45 |\n#+TBLFM: $2=month($1)::$3=weekday($1)::$4=hour($1)::$5=minute($1)\n"
  }
 },
 {
  "name": "vmax of dates",
  "text": "| <2024-01-01 Mon> | <2024-01-05 Fri> |  |\n#+TBLFM: $3=vmax($1..$2)\n",
