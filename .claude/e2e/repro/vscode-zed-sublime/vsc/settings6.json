{
  "folder": {
    "org-lsp.settings": {
      "clock": { "today": "2026-05-18", "now": "10:30" },
      "emacs_config": "(add-to-list 'load-path \"/root/org-mode/lisp\")\n(setq org-export-backends '(ascii html icalendar latex odt md))",
      "org_cycle_global_at_bob": true,
      "org_log_refile": "note",
      "org_agenda_files": ["$WS/ag.org"],
      "org_super_agenda_mode": true,
      "org_super_agenda_groups": [{ "name": "Today", "time-grid": true }, { "auto-category": true }],
      "org_capture_templates": [
        { "key": "f", "description": "File", "target": ["file", "$WS/inbox.org"], "template": "* From file\n%[snippet.txt]%c\n" }
      ]
    }
  }
}
