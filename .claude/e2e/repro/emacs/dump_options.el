;;; dump_options.el --- print each option of emacs-options.json as Emacs has it, as JSON lines.
(add-to-list 'load-path "/root/org-mode/lisp")
(require 'json)
(require 'cus-edit)
(let* ((json-object-type 'alist) (json-key-type 'string)
       (data (json-read-file "/home/user/org-lsp/scripts/emacs-options.json")))
  (dolist (file data)
    (let ((feature (intern (string-remove-suffix ".el" (car file)))))
      (condition-case err (require feature) (error (message "NOREQ %s %S" feature err)))
      (dolist (opt (cdr file))
        (let* ((sym (intern (car opt))))
          (princ (json-encode
                  `((name . ,(car opt))
                    (doc . ,(let ((d (documentation-property sym 'variable-documentation t))) (or d "")))
                    (raw . ,(or (get sym 'variable-documentation) ""))
                    (default . ,(condition-case nil (let ((print-escape-newlines t)) (prin1-to-string (eval (car (get sym 'standard-value)) t))) (error "ERR")))
                    (source . ,(let ((print-escape-newlines t)) (prin1-to-string (car (get sym 'standard-value)))))
                    (type . ,(let ((print-escape-newlines t)) (prin1-to-string (get sym 'custom-type))))
                    (version . ,(format "%S" (get sym 'custom-version)))
                    (pkg . ,(format "%S" (get sym 'custom-package-version))))))
          (princ "\n"))))))
