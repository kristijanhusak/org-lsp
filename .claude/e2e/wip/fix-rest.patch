@@ -2783,6 +2828,10 @@ function! org_lsp#attach() abort
       " calendar moves to the bottom.
       execute 'autocmd BufWinEnter <buffer=' . nr . '> call timer_start(0, {-> s:place_prompt(' . nr . ')})'
