+-- TESTING.org: Headings and structure, Lists and checkboxes, TODO
+-- keywords, Priorities, Tags.
+local H = dofile('/home/user/org-lsp/.claude/e2e/repro/neovim/h.lua')
+local dir = H.tmpdir('structure')
+H.init({
+  settings = {
+    clock = { today = '2026-10-21', now = '10:00' },
+    org_agenda_files = { dir },
+    org_log_done = 'time',
+    org_todo_keywords = { 'TODO(t)', 'WAIT(w@)', '|', 'DONE(d)' },
+  },
+})
+local eq, check, press, line, lines, wait = H.eq, H.check, H.press, H.line, H.lines, H.wait
+
+local function becomes(n, text, msg)
+  return wait(msg .. ': ' .. text, function()
+    return line(n) == text
+  end)
+end
+local function all_become(expected, msg)
+  local ok = H.wait(nil, function()
+    return vim.deep_equal(lines(), expected)
+  end)
+  return eq(lines(), expected, msg)
+end
+
+H.section('new headings', function()
+  H.open(dir .. '/h.org', { '* A', 'text a', '** A1', '* B' })
+  vim.api.nvim_win_set_cursor(0, { 1, 0 })
+  press('<Leader><CR>')
+  wait('a new heading', function() return #lines() == 5 end)
+  H.out('  M-RET on * A -> ' .. vim.inspect(lines()) .. ' cursor ' .. vim.inspect(H.cursor()) .. ' mode ' .. vim.api.nvim_get_mode().mode)
+  vim.cmd('stopinsert')
+  -- Emacs `org-insert-heading` at the end of a headline: a new heading of the same level after the line
+  H.open(dir .. '/h2.org', { '* A', 'text a', '** A1', '* B' })
+  vim.api.nvim_win_set_cursor(0, { 1, 0 })
+  press('<Leader>oiT')
+  wait('a TODO heading', function() return #lines() == 5 end)
+  H.out('  oiT on * A -> ' .. vim.inspect(lines()))
+  vim.cmd('stopinsert')
+  H.open(dir .. '/h3.org', { '* A', 'text a', '** A1', '* B' })
