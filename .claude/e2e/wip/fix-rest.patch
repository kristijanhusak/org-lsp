+- Default ::
+  #+begin_src emacs-lisp
+  (closure
+      (htmlize-buffer-places org-html-format-table-no-css htmlize-css-name-prefix htmlize-output-type htmlize-output-type htmlize-css-name-prefix t)
+      (_name contents)
+    contents)
