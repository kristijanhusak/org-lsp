+- Since :: Org 9.0
+
+#+begin_src toml
+[emacs_options]
+org-babel-hash-show-time = false
+#+end_src
+
+*** org-babel-uppercase-example-markers
+:PROPERTIES:
+:CUSTOM_ID: org-babel-uppercase-example-markers
+:END:
+
+When non-nil, begin/end example markers will be inserted in upper case.
+
+- Default :: ~nil~
+- Type :: ~boolean~
+- Since :: Org 9.1
+
+#+begin_src toml
+[emacs_options]
+org-babel-uppercase-example-markers = false
+#+end_src
+
+*** org-babel-remote-temporary-directory
+:PROPERTIES:
+:CUSTOM_ID: org-babel-remote-temporary-directory
+:END:
