+    def check(self, index, kind):
+        try:
+            got = self.snapshot(kind).replace(self.directory, "$DIR")
+        except zr.Failure as error:
+            got = f"(failed: {error})"
+        self.record.append({"step": index, "kind": kind, "got": got})
