+  "org-cycle-level-faces": "setting"
  },
  "org-feed.el": {
   "org-feed-alist": "absent",
@@ -856,7 +856,7 @@
   "org-fontify-todo-headline": "setting",
   "org-fontify-done-headline": "setting",
   "org-fontify-emphasized-text": "setting",
-  "org-fontify-whole-heading-line": ["other", "editors draw a token's look over its text only: past the end of a headline's text the line keeps the editor's background"],
