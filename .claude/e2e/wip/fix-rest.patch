+open(SCRATCH + '/edit/in.csv', 'w').write('x,y\n5,6\n')
+m = len(c.messages)
+r = c.cmd('org.table.import', u, (11, 4), answers=[SCRATCH + '/edit/in.csv']); c.settle(2)
+print('== import ->', json.dumps(c.trail)[:300], c.messages[m:], repr(c.text(u)[-80:]))
+m = len(c.messages)
