+   "type": "(choice :convert-widget\n        (lambda\n          (w)\n          (apply 'widget-convert\n                 (widget-type w)\n                 (eval\n                  (car\n                   (widget-get w :args)))))\n        `((const :tag \"None\" nil)\n          ,@(mapcar\n             (lambda\n               (c)\n               `(const :tag ,c ,c))\n             (org-odt-reachable-formats \"odt\"))))",
