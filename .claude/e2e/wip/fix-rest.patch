+  end,
+})
+local eq, check, press, line, lines, wait = H.eq, H.check, H.press, H.line, H.lines, H.wait
+
+H.section('config.toml and settings', function()
+  H.open(dir .. '/a.org', { '* TODO Task', '* B' })
+  press('<Leader>tt')
