+*** org-icalendar-use-deadline
+:PROPERTIES:
+:CUSTOM_ID: org-icalendar-use-deadline
+:END:
+
+Contexts where iCalendar export should use a deadline time stamp.
+
+This is a list with possibly several symbols in it.  Valid symbols are:
+
+~event-if-todo~
+
+#+begin_example
+Deadlines in TODO entries become calendar events.
+#+end_example
+
+~event-if-todo-not-done~
+
+#+begin_example
+Deadlines in TODO entries with not-DONE state become events.
+#+end_example
+
+~event-if-not-todo~
+
+#+begin_example
+Deadlines in non-TODO entries become calendar events.
+#+end_example
+
+~todo-due~
+
+#+begin_example
+Use deadlines in TODO entries as due-dates.
+#+end_example
+
+- Default :: ~(event-if-not-todo todo-due)~
+- Type ::
+  #+begin_src emacs-lisp
+  (set :greedy t
+       (const :tag "DEADLINE in non-TODO entries become events" event-if-not-todo)
+       (const :tag "DEADLINE in TODO entries become events" event-if-todo)
+       (const :tag "DEADLINE in TODO entries with not-DONE state become events" event-if-todo-not-done)
+       (const :tag "DEADLINE in TODO entries become due-dates" todo-due))
+  #+end_src
+
+#+begin_src toml
+[emacs_options]
+org-icalendar-use-deadline = ["event-if-not-todo", "todo-due"]
+#+end_src
+
+*** org-icalendar-use-scheduled
+:PROPERTIES:
+:CUSTOM_ID: org-icalendar-use-scheduled
+:END:
+
+Contexts where iCalendar export should use a scheduling time stamp.
+
+This is a list with possibly several symbols in it.  Valid symbols are:
+
+~event-if-todo~
+
+#+begin_example
+Scheduling time stamps in TODO entries become an event.
+#+end_example
+
+~event-if-todo-not-done~
+
+#+begin_example
+Scheduling time stamps in TODO entries with not-DONE state
+become events.
+#+end_example
+
+~event-if-not-todo~
+
+#+begin_example
+Scheduling time stamps in non-TODO entries become an event.
+#+end_example
+
+~todo-start~
+
+#+begin_example
+Scheduling time stamps in TODO entries become start date.  (See
+also `org-icalendar-todo-unscheduled-start', which controls the
+start date for TODO entries without a scheduling time stamp)
+#+end_example
+
+- Default :: ~(todo-start)~
+- Type ::
+  #+begin_src emacs-lisp
+  (set :greedy t
+       (const :tag "SCHEDULED timestamps in non-TODO entries become events" event-if-not-todo)
+       (const :tag "SCHEDULED timestamps in TODO entries become events" event-if-todo)
+       (const :tag "SCHEDULED in TODO entries with not-DONE state become events" event-if-todo-not-done)
+       (const :tag "SCHEDULED in TODO entries become start date" todo-start))
+  #+end_src
+
+#+begin_src toml
+[emacs_options]
+org-icalendar-use-scheduled = ["todo-start"]
+#+end_src
+
+*** org-icalendar-categories
+:PROPERTIES:
+:CUSTOM_ID: org-icalendar-categories
+:END:
+
+Items that should be entered into the "categories" field.
