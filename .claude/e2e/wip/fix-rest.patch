+   "type": "(choice\n (const :tag \"None\" nil)\n (const :tag \"Unfinished\" t)\n (const :tag \"Unblocked\" unblocked)\n (const :tag \"All\" all)\n (repeat :tag \"Specific TODO keywords\"\n         (string :tag \"Keyword\")))",
+   "json": []
