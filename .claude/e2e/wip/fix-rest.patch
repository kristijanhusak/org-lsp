+  "org-html-mathjax-template": {
+   "doc": "The MathJax template.  See also `org-html-mathjax-options'.",
+   "default": "\"<script>\\n  window.MathJax = {\\n    tex: {\\n      ams: {\\n        multlineWidth: '%MULTLINEWIDTH'\\n      },\\n      tags: '%TAGS',\\n      tagSide: '%TAGSIDE',\\n      tagIndent: '%TAGINDENT'\\n    },\\n    chtml: {\\n      scale: %SCALE,\\n      displayAlign: '%ALIGN',\\n      displayIndent: '%INDENT'\\n    },\\n    svg: {\\n      scale: %SCALE,\\n      displayAlign: '%ALIGN',\\n      displayIndent: '%INDENT'\\n    },\\n    output: {\\n      font: '%FONT',\\n      displayOverflow: '%OVERFLOW'\\n    }\\n  };\\n</script>\\n\\n<script\\n  id=\\\"MathJax-script\\\"\\n  async\\n  src=\\\"%PATH\\\">\\n</script>\"",
