+  H.out('  after copy: ' .. vim.inspect(lines()))
+  vim.api.nvim_win_set_cursor(0, { 2, 0 })
+  H.selects({ 'Projects' })
+  press('<Leader>or')
+  wait('refiled', function() return line(2) == '** Item two' end)
+  H.out('  after refile: ' .. vim.inspect(lines()))
