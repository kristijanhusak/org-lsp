Claude-Session: https://claude.ai/code/session_01F8WHf8fTvjUpFp8gNQrPFQ
---
 docs/org-protocol.org | 6 +++---
 scripts/install.sh    | 4 ++--
 2 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/docs/org-protocol.org b/docs/org-protocol.org
index 4014fec..4d93a9d 100644
--- a/docs/org-protocol.org
+++ b/docs/org-protocol.org
@@ -65,8 +65,8 @@ moving the server. What it does, which can be done by hand as well:
   declares the scheme and hides it from the Dock (~LSUIElement~) with
   ~PlistBuddy~, and registers it with ~lsregister~. When another application
   (Emacs.app) has the scheme too, make this one its handler, with [[https://github.com/moretension/duti][duti]]:
-  ~duti -s org.org-lsp.protocol org-protocol~. /This is not tested by the
-  project's checks./
+  ~duti -s org.org-lsp.protocol org-protocol~. The [[file:../.github/workflows/protocol.yml][org-protocol workflow]]
+  registers it on macOS and opens a ~store-link~ URL through the system.
 - Windows :: the scheme in the registry, under
   ~HKEY_CURRENT_USER\Software\Classes\org-protocol~; the script does it
   with ~reg~ in Git Bash. By hand, a ~.reg~ file (its backslashes
@@ -94,7 +94,7 @@ moving the server. What it does, which can be done by hand as well:
   #+end_src
 
   ~org-lsp.exe~ is a console program: a console window may flash as it
-  runs. /This is not tested by the project's checks./
+  runs. The same workflow checks it on Windows.
 
 The browser asks once whether to open ~org-protocol~ links with it.
 
diff --git a/scripts/install.sh b/scripts/install.sh
index 6357e9d..dbf53ac 100755
--- a/scripts/install.sh
+++ b/scripts/install.sh
@@ -210,7 +210,7 @@ EOF
 
 # macOS: a small application that declares the scheme (CFBundleURLTypes): an
 # AppleScript applet whose `open location` runs `org-lsp protocol URL`,
-# registered with Launch Services. Not tested by the project's checks.
+# registered with Launch Services. .github/workflows/protocol.yml checks it.
 register_protocol_macos() {
   local path=$1
   local app=$HOME/Applications/org-lsp-protocol.app
@@ -239,7 +239,7 @@ EOF
 }
 
 # Windows: the scheme under HKEY_CURRENT_USER\Software\Classes, its command
-# `org-lsp.exe protocol "%1"`. Not tested by the project's checks.
+# `org-lsp.exe protocol "%1"`. .github/workflows/protocol.yml checks it.
 register_protocol_windows() {
   local path=$1 windows_path
   windows_path=$(cygpath -w "$path" 2> /dev/null || printf '%s' "$path")
-- 
