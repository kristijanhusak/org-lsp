+  H.open(dir .. '/l.org', {
+    '#+LINK: gh https://github.com/%s',
+    '* Links',
+    '[[gh:org-lsp]] [[ddg:org]] [[Target]] [[#cid]] [[target]] [[file:other.org::*X]]',
+    '[[No such heading]] [[file:notes.txt]] [[shell:echo hi]]',
