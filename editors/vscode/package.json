{
  "name": "org-lsp",
  "displayName": "Org (org-lsp)",
  "description": "Org mode support through the org-lsp language server: highlighting, folding, outline, TODO states and the agenda.",
  "version": "0.1.0",
  "publisher": "org-lsp",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/kristijanhusak/org-lsp.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "org",
        "aliases": [
          "Org",
          "org"
        ],
        "extensions": [
          ".org",
          ".org_archive"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "org-agenda",
        "aliases": [
          "Org Agenda"
        ],
        "extensions": [
          ".org-agenda"
        ],
        "filenames": [
          "Org Agenda"
        ]
      },
      {
        "id": "org-date",
        "aliases": [
          "Org Date Prompt"
        ],
        "filenames": [
          "Org Date"
        ]
      }
    ],
    "commands": [
      {
        "command": "org.agenda.dispatch",
        "title": "Agenda commands",
        "category": "Org"
      },
      {
        "command": "org.agenda.list",
        "title": "Agenda for the current week or day",
        "category": "Org"
      },
      {
        "command": "org.agenda.todos",
        "title": "List of all TODO entries",
        "category": "Org"
      },
      {
        "command": "org.agenda.later",
        "title": "Agenda: go forward in time",
        "category": "Org"
      },
      {
        "command": "org.agenda.earlier",
        "title": "Agenda: go backward in time",
        "category": "Org"
      },
      {
        "command": "org.agenda.today",
        "title": "Agenda: go to today",
        "category": "Org"
      },
      {
        "command": "org.agenda.day",
        "title": "Agenda: day view",
        "category": "Org"
      },
      {
        "command": "org.agenda.week",
        "title": "Agenda: week view",
        "category": "Org"
      },
      {
        "command": "org.agenda.fortnight",
        "title": "Agenda: fortnight view",
        "category": "Org"
      },
      {
        "command": "org.agenda.month",
        "title": "Agenda: month view",
        "category": "Org"
      },
      {
        "command": "org.agenda.year",
        "title": "Agenda: year view",
        "category": "Org"
      },
      {
        "command": "org.agenda.redo",
        "title": "Agenda: rebuild",
        "category": "Org"
      },
      {
        "command": "org.agenda.goto",
        "title": "Agenda: go to the entry",
        "category": "Org"
      },
      {
        "command": "org.agenda.save",
        "title": "Save all Org files",
        "category": "Org"
      },
      {
        "command": "org.todo.next",
        "title": "Cycle TODO state forward",
        "category": "Org"
      },
      {
        "command": "org.todo.previous",
        "title": "Cycle TODO state backward",
        "category": "Org"
      },
      {
        "command": "org.priority.up",
        "title": "Raise the priority",
        "category": "Org"
      },
      {
        "command": "org.priority.down",
        "title": "Lower the priority",
        "category": "Org"
      },
      {
        "command": "org.timestamp.up",
        "title": "Increase the part of the timestamp at the cursor",
        "category": "Org"
      },
      {
        "command": "org.timestamp.down",
        "title": "Decrease the part of the timestamp at the cursor",
        "category": "Org"
      },
      {
        "command": "org.date.later",
        "title": "Move the date one day later",
        "category": "Org"
      },
      {
        "command": "org.date.earlier",
        "title": "Move the date one day earlier",
        "category": "Org"
      },
      {
        "command": "org.shift.up",
        "title": "Increase the timestamp part or raise the priority",
        "category": "Org"
      },
      {
        "command": "org.shift.down",
        "title": "Decrease the timestamp part or lower the priority",
        "category": "Org"
      },
      {
        "command": "org.shift.left",
        "title": "Move the date a day earlier or cycle the TODO state backward",
        "category": "Org"
      },
      {
        "command": "org.shift.right",
        "title": "Move the date a day later or cycle the TODO state forward",
        "category": "Org"
      },
      {
        "command": "org.schedule",
        "title": "Schedule the entry",
        "category": "Org"
      },
      {
        "command": "org.deadline",
        "title": "Set the deadline of the entry",
        "category": "Org"
      },
      {
        "command": "org.timestamp.insert",
        "title": "Insert or change a timestamp",
        "category": "Org"
      },
      {
        "command": "org.timestamp.insert.inactive",
        "title": "Insert or change an inactive timestamp",
        "category": "Org"
      },
      {
        "command": "org.calendar.day.later",
        "title": "Date prompt: one day later",
        "category": "Org"
      },
      {
        "command": "org.calendar.day.earlier",
        "title": "Date prompt: one day earlier",
        "category": "Org"
      },
      {
        "command": "org.calendar.week.later",
        "title": "Date prompt: one week later",
        "category": "Org"
      },
      {
        "command": "org.calendar.week.earlier",
        "title": "Date prompt: one week earlier",
        "category": "Org"
      },
      {
        "command": "org.calendar.month.later",
        "title": "Date prompt: one month later",
        "category": "Org"
      },
      {
        "command": "org.calendar.month.earlier",
        "title": "Date prompt: one month earlier",
        "category": "Org"
      },
      {
        "command": "org.calendar.year.later",
        "title": "Date prompt: one year later",
        "category": "Org"
      },
      {
        "command": "org.calendar.year.earlier",
        "title": "Date prompt: one year earlier",
        "category": "Org"
      },
      {
        "command": "org.calendar.scroll.later",
        "title": "Date prompt: show the next months",
        "category": "Org"
      },
      {
        "command": "org.calendar.scroll.earlier",
        "title": "Date prompt: show the previous months",
        "category": "Org"
      },
      {
        "command": "org.calendar.today",
        "title": "Date prompt: go to today",
        "category": "Org"
      },
      {
        "command": "org.calendar.select",
        "title": "Date prompt: take the day at the cursor",
        "category": "Org"
      },
      {
        "command": "org.calendar.type",
        "title": "Date prompt: type the date",
        "category": "Org"
      },
      {
        "command": "org.calendar.cancel",
        "title": "Date prompt: cancel",
        "category": "Org"
      },
      {
        "command": "org-lsp.restartServer",
        "title": "Restart Language Server",
        "category": "Org"
      }
    ],
    "configuration": {
      "title": "Org (org-lsp)",
      "properties": {
        "org-lsp.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the `org-lsp` server binary. When empty, the binary bundled with the extension is used, or else `org-lsp` from `PATH`."
        },
        "org-lsp.settings": {
          "type": "object",
          "default": {},
          "markdownDescription": "The server's options, for example `{ \"agendaFiles\": [\"~/org\"], \"todoKeywords\": [\"TODO\", \"NEXT\", \"|\", \"DONE\"], \"logDone\": \"time\" }`. Without `agendaFiles`, the agenda is built from the Org files in the workspace folders. The options are listed in the server's `docs/protocol.md`."
        }
      }
    },
    "configurationDefaults": {
      "[org]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.lightbulb.enabled": "off",
        "editor.bracketPairColorization.enabled": false
      },
      "[org-agenda]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.lightbulb.enabled": "off",
        "editor.bracketPairColorization.enabled": false,
        "editor.lineNumbers": "off",
        "editor.wordWrap": "off",
        "editor.folding": false,
        "editor.guides.indentation": false,
        "editor.occurrencesHighlight": "off",
        "editor.selectionHighlight": false,
        "editor.stickyScroll.enabled": false
      },
      "[org-date]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.lightbulb.enabled": "off",
        "editor.bracketPairColorization.enabled": false,
        "editor.lineNumbers": "off",
        "editor.wordWrap": "off",
        "editor.folding": false,
        "editor.guides.indentation": false,
        "editor.occurrencesHighlight": "off",
        "editor.selectionHighlight": false,
        "editor.stickyScroll.enabled": false,
        "editor.minimap.enabled": false,
        "editor.renderWhitespace": "none"
      }
    },
