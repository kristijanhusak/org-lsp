{
  "command": [
    "org-lsp"
  ],
  "selector": "text.org | text.org-agenda",
  "syntax_map": {
    "org-agenda": "Packages/LSP-org/Org Agenda.sublime-syntax"
  },
  "schemes": [
    "file",
    "org-agenda"
  ],
  "initializationOptions": {},
  "org_keys": "emacs",
  "org_messages": "popup",
  "org_images": true,
  "semantic_tokens": {
    "headline": "entity.name.section markup.heading markup.heading.org",
    "headline.level1": "entity.name.function markup.heading.1.org",
    "headline.level2": "variable.parameter markup.heading.2.org",
    "headline.level3": "keyword markup.heading.3.org",
    "headline.level4": "comment markup.heading.4.org",
    "headline.level5": "storage.type markup.heading.5.org",
    "headline.level6": "constant.language markup.heading.6.org",
    "headline.level7": "support.function markup.heading.7.org",
    "headline.level8": "string markup.heading.8.org",
    "stars": "markup.heading punctuation.definition.heading.org",
    "todoKeyword": "keyword.control markup.deleted keyword.other.todo.org",
    "todoKeyword.done": "string markup.inserted keyword.other.done.org",
    "priority": "constant.numeric constant.other.priority.org",
    "tag": "entity.name.tag entity.name.tag.org",
    "planning": "keyword.other keyword.other.planning.org",
    "timestamp": "constant.numeric constant.other.timestamp.org",
    "timestamp.inactive": "comment comment.timestamp.org",
    "drawer": "support.function meta.preprocessor meta.preprocessor.drawer.org",
    "property": "entity.other.attribute-name variable.other.property variable.other.property.org",
    "keyword": "comment meta.preprocessor meta.preprocessor.keyword.org",
    "block": "comment punctuation.definition.block.org",
    "quote": "markup.quote markup.quote.org",
    "verse": "markup.quote markup.quote.verse.org",
    "comment": "comment comment.line.org",
    "bullet": "keyword.operator punctuation.definition.list.begin.markdown punctuation.definition.list.begin.org",
    "checkbox": "keyword.operator markup.list.unchecked.org",
    "checkbox.checked": "string markup.inserted markup.list.checked.org",
    "link": "string.other.link markup.underline.link markup.underline.link.org",
    "code": "string markup.inline.raw markup.inline.raw.org",
    "verbatim": "string markup.inline.raw markup.inline.raw.org",
    "tableDelimiter": "comment punctuation.definition.table punctuation.separator.table.org",
    "footnote": "string.other.link markup.underline.link markup.underline.link.footnote.org",
    "cookie": "constant.numeric constant.numeric.cookie.org",
    "cookie.done": "string markup.inserted constant.numeric.cookie.done.org",
    "headline.done": "comment markup.heading.done.org",
    "text.done": "comment comment.done.org",
    "headline.todo": "string markup.heading.todo.org",
    "text.todo": "string string.todo.org",
    "documentTitle": "entity.name.section markup.heading.title.org",
    "documentInfo": "string string.other.info.org",
    "target": "entity.name.label entity.name.label.org",
    "latex": "support.function markup.math.org",
    "entity": "constant.character.entity constant.character.entity.org",
    "macro": "entity.name.function.preprocessor entity.name.function.macro.org",
    "text.bold": "markup.bold markup.bold.org",
    "text.italic": "markup.italic markup.italic.org",
    "text.underline": "markup.underline markup.underline.org",
    "text.strikethrough": "markup.strikethrough markup.strikethrough.org",
    "agendaStructure": "entity.name.section markup.heading markup.heading.agenda.org",
    "agendaDate": "entity.name.section markup.heading markup.heading.date.agenda.org",
    "agendaDate.today": "entity.name.section markup.heading markup.bold markup.bold.today.agenda.org",
    "agendaDate.weekend": "entity.name.section markup.heading markup.italic markup.italic.weekend.agenda.org",
    "agendaScheduled": "string markup.inserted markup.inserted.scheduled.agenda.org",
    "agendaScheduled.past": "constant.numeric markup.changed markup.changed.scheduled.agenda.org",
    "agendaDeadline": "constant.numeric markup.changed markup.changed.deadline.agenda.org",
    "agendaDeadline.imminent": "keyword.control markup.deleted markup.deleted.deadline.agenda.org",
    "agendaDeadline.distant": "comment comment.deadline.agenda.org",
    "agendaDone": "comment comment.done.agenda.org",
    "agendaHabit": "markup.changed markup.changed.habit.agenda.org",
    "agendaHabit.ready": "markup.inserted markup.inserted.habit.agenda.org",
    "agendaHabit.alert": "constant.numeric markup.changed markup.changed.alert.habit.agenda.org",
    "agendaHabit.overdue": "markup.deleted markup.deleted.habit.agenda.org",
    "agendaTimeGrid": "comment comment.time-grid.agenda.org",
    "agendaTimeGrid.current": "comment markup.bold markup.bold.current-time.agenda.org",
    "agendaClocking": "markup.inserted markup.highlight.clocking.agenda.org",
    "text.clocking": "markup.inserted markup.highlight.clocking.agenda.org",
    "agendaDimmed": "comment comment.dimmed.agenda.org",
    "text.archived": "comment comment.archived.org",
    "calendarHeader": "entity.name.function entity.name.function.month.calendar.org",
    "calendarWeekday": "constant.other constant.other.weekday.calendar.org",
    "calendarWeekday.weekend": "comment comment.weekend.calendar.org",
    "calendarSelected": "invalid.illegal markup.inverse.selected.calendar.org",
    "calendarPrompt": "keyword keyword.other.prompt.calendar.org",
    "calendarJournal": "markup.italic markup.italic.journal.calendar.org",
    "calendarJournal.future": "markup.italic markup.italic.scheduled.journal.calendar.org"
  }
}
