      scope: comment punctuation.definition.block.org
      embed: scope:source.python
      embed_scope: meta.embedded.block.org
      escape: '^\s*(?i:#\+end_\1)\b.*$'
      escape_captures:
        0: comment punctuation.definition.block.org
    - match: '(?<![\w-])src_(?i:python|py)(?:\[[^\]\n]*\])?\{'
