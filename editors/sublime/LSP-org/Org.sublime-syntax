        0: comment punctuation.definition.block.org
    - match: '(?<![\w-])src_(?i:dot)(?:\[[^\]\n]*\])?\{'
      scope: markup.inline.raw.org
      embed: scope:source.dot
      embed_scope: meta.embedded.inline.org
      escape: '\}'
      escape_captures:
        0: markup.inline.raw.org
    # --- end of source blocks ---
    - match: '^\s*#\+(?i:begin_src|begin_example|begin_export)\b.*$'
      scope: comment punctuation.definition.block.org
      push: raw-block
    - match: '^\s*#\+(?i:begin|end)_\w+.*$'
      scope: comment punctuation.definition.block.org
    - match: '^\s*(#\+\w+:)(.*)$'
      captures:
        1: comment meta.preprocessor meta.preprocessor.keyword.org
    - match: '^\s*#(\s.*)?$'
      scope: comment comment.line.org
    - match: '^\s*(CLOCK:)'
      captures:
        1: keyword.other keyword.other.planning.org
    - match: '^(?=\s*(?:SCHEDULED|DEADLINE|CLOSED):)'
      push: planning
    - match: '^\s*:(?:END|[\w-]+):\s*$'
      scope: support.function meta.preprocessor meta.preprocessor.drawer.org
    - match: '^\s*(:[\w-]+\+?:)(?=\s|$)'
      captures:
        1: entity.other.attribute-name variable.other.property variable.other.property.org
    - match: '^\s*(?=\|)'
      push: table
    - match: '^\s*([-+]|(?<=\s)\*|\d+[.)]|[a-zA-Z][.)])(?=\s|$)(?:\s+(?:(\[X\])|(\[[ -]\])))?'
      captures:
        1: keyword.operator punctuation.definition.list.begin.markdown punctuation.definition.list.begin.org
        2: string markup.inserted markup.list.checked.org
        3: keyword.operator markup.list.unchecked.org
    - include: inline

  heading-start:
    - match: '\s+({{todo}})(?=\s|$)'
      captures:
        1: keyword.control markup.deleted keyword.other.todo.org
      set: heading-priority
    - match: '\s+({{done}})(?=\s|$)'
      captures:
        1: string markup.inserted keyword.other.done.org
      set: heading-priority
    - match: ''
      set: heading-priority

  heading-priority:
    - match: '\s+(\[#[A-Z0-9]+\])'
      captures:
        1: constant.numeric constant.other.priority.org
      pop: true
    - match: ''
      pop: true

  heading-1:
    - meta_scope: entity.name.function markup.heading.org markup.heading.1.org
    - include: heading-rest
  heading-2:
    - meta_scope: variable.parameter markup.heading.org markup.heading.2.org
    - include: heading-rest
  heading-3:
    - meta_scope: keyword markup.heading.org markup.heading.3.org
    - include: heading-rest
  heading-4:
    - meta_scope: comment markup.heading.org markup.heading.4.org
    - include: heading-rest
  heading-5:
    - meta_scope: storage.type markup.heading.org markup.heading.5.org
    - include: heading-rest
  heading-6:
    - meta_scope: constant.language markup.heading.org markup.heading.6.org
    - include: heading-rest
  heading-7:
    - meta_scope: support.function markup.heading.org markup.heading.7.org
    - include: heading-rest
  heading-8:
    - meta_scope: string markup.heading.org markup.heading.8.org
    - include: heading-rest

  heading-rest:
    - match: '$'
      pop: true
    - match: '\s(:(?:[\w@#%]+:)+)[ \t]*$'
      captures:
        1: entity.name.tag entity.name.tag.org
    - include: inline

  inline:
    - match: '<\d{4}-\d{2}-\d{2}[^>\n]*>(?:--<\d{4}-\d{2}-\d{2}[^>\n]*>)?'
      scope: constant.numeric constant.other.timestamp.org
    - match: '\[\d{4}-\d{2}-\d{2}[^\]\n]*\](?:--\[\d{4}-\d{2}-\d{2}[^\]\n]*\])?'
      scope: comment comment.timestamp.org
    - match: '\[\[[^\]\n]+\](?:\[[^\]\n]*\])?\]'
      scope: string.other.link markup.underline.link markup.underline.link.org
    - match: '\[fn:[^\]\n]*\]'
      scope: string.other.link markup.underline.link markup.underline.link.footnote.org
    - match: '\[(?:\d*%|\d*/\d*)\]'
      scope: constant.numeric constant.numeric.cookie.org
    - match: '<<[^<>\n]+>>'
      scope: entity.name.label entity.name.label.org
    - match: '{{{[^}\n]+}}}'
      scope: entity.name.function.preprocessor entity.name.function.macro.org
    - match: '{{pre}}=[^\s=](?:[^\n]*?[^\s])?={{post}}'
      scope: string markup.inline.raw markup.inline.raw.org
    - match: '{{pre}}~[^\s~](?:[^\n]*?[^\s])?~{{post}}'
      scope: string markup.inline.raw markup.inline.raw.org
    - match: '{{pre}}\*[^\s*](?:[^\n]*?[^\s])?\*{{post}}'
      scope: markup.bold markup.bold.org
    - match: '{{pre}}/[^\s/](?:[^\n]*?[^\s])?/{{post}}'
      scope: markup.italic markup.italic.org
    - match: '{{pre}}_[^\s_](?:[^\n]*?[^\s])?_{{post}}'
      scope: markup.underline markup.underline.org
    - match: '{{pre}}\+[^\s+](?:[^\n]*?[^\s])?\+{{post}}'
      scope: markup.strikethrough markup.strikethrough.org
  planning:
    - match: '$'
      pop: true
    - match: '\b(?:SCHEDULED|DEADLINE|CLOSED):'
      scope: keyword.other keyword.other.planning.org
    - include: inline

  table:
    - match: '$'
      pop: true
    - match: '\|'
      scope: comment punctuation.definition.table punctuation.separator.table.org
    - match: '(?<=\|)-[-+|]*'
      scope: comment punctuation.definition.table punctuation.separator.table.org
    - include: inline

  raw-block:
    - meta_content_scope: string markup.raw.block.org
    - match: '^\s*#\+(?i:end_\w+).*$'
      scope: comment punctuation.definition.block.org
      pop: true
