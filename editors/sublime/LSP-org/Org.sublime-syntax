# Org files, for the language server to attach to. The server colors them
# (semantic tokens, with LSP's `semantic_highlighting` on and a color
# scheme that allows it); this colors what a pattern can find, without the
# server's colors or until they arrive. The scopes are those of
# LSP-org.sublime-settings.
name: Org
file_extensions: [org, org_archive]
scope: text.org
variables:
  todo: '(?:TODO|NEXT|STARTED|WAITING|HOLD|SOMEDAY)'
  done: '(?:DONE|CANCELLED|CANCELED)'
  # Where emphasis can start and end (`org-emphasis-regexp-components`).
  pre: '(?:^|(?<=[\s\-(''"{]))'
  post: '(?=$|[\s\-.,;:!?''")}\[])'
contexts:
  main:
    - match: '^(\*{1})(?=\s)'
      captures:
        1: markup.heading punctuation.definition.heading.org
      push: [heading-1, heading-start]
    - match: '^(\*{2})(?=\s)'
      captures:
        1: markup.heading punctuation.definition.heading.org
      push: [heading-2, heading-start]
    - match: '^(\*{3})(?=\s)'
      captures:
        1: markup.heading punctuation.definition.heading.org
      push: [heading-3, heading-start]
    - match: '^(\*{4})(?=\s)'
      captures:
        1: markup.heading punctuation.definition.heading.org
      push: [heading-4, heading-start]
    - match: '^(\*{5})(?=\s)'
      captures:
        1: markup.heading punctuation.definition.heading.org
      push: [heading-5, heading-start]
    - match: '^(\*{6})(?=\s)'
      captures:
        1: markup.heading punctuation.definition.heading.org
      push: [heading-6, heading-start]
    - match: '^(\*{7})(?=\s)'
      captures:
        1: markup.heading punctuation.definition.heading.org
      push: [heading-7, heading-start]
    - match: '^(\*{8,})(?=\s)'
      captures:
        1: markup.heading punctuation.definition.heading.org
      push: [heading-8, heading-start]
    # Source and export blocks, and inline source blocks, in their
