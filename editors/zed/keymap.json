[
  {
    "context": "Editor && extension == org-agenda",
    "bindings": {
      "q": "pane::CloseActiveItem",
      "enter": "editor::GoToDefinition",
      "tab": "editor::GoToDefinitionSplit",
      "f": [
        "task::Spawn",
        {
          "task_name": "Org agenda: go forward in time"
        }
      ],
      "b": [
        "task::Spawn",
        {
          "task_name": "Org agenda: go backward in time"
        }
      ],
      ".": [
        "task::Spawn",
        {
          "task_name": "Org agenda: go to today"
        }
      ],
      "[": [
        "task::Spawn",
        {
          "task_name": "Org agenda: search for another word"
        }
      ],
      "]": [
        "task::Spawn",
        {
          "task_name": "Org agenda: search without a word"
        }
      ],
      "{": [
        "task::Spawn",
        {
          "task_name": "Org agenda: search for another regexp"
        }
      ],
      "}": [
        "task::Spawn",
        {
          "task_name": "Org agenda: search without a regexp"
        }
      ],
      "shift-j": [
        "task::Spawn",
        {
          "task_name": "Org agenda: go to a date"
        }
      ],
      "v d": [
        "task::Spawn",
        {
          "task_name": "Org agenda: day view"
        }
      ],
      "v w": [
        "task::Spawn",
        {
          "task_name": "Org agenda: week view"
        }
      ],
      "v t": [
        "task::Spawn",
        {
          "task_name": "Org agenda: fortnight view"
        }
      ],
      "v m": [
        "task::Spawn",
        {
          "task_name": "Org agenda: month view"
        }
      ],
      "v y": [
        "task::Spawn",
        {
          "task_name": "Org agenda: year view"
        }
      ],
      "r": [
        "task::Spawn",
        {
          "task_name": "Org agenda: rebuild"
        }
      ],
      "s": [
        "task::Spawn",
        {
          "task_name": "Org agenda: Save all Org files"
        }
      ],
      "ctrl-x ctrl-s": [
        "task::Spawn",
        {
          "task_name": "Org agenda: Save all Org files"
        }
      ],
      "v l": [
        "task::Spawn",
        {
          "task_name": "Org agenda: log mode, what was closed and clocked"
        }
      ],
      "shift-r": [
        "task::Spawn",
        {
          "task_name": "Org agenda: the clock report"
        }
      ],
      "v shift-r": [
        "task::Spawn",
        {
          "task_name": "Org agenda: the clock report"
        }
      ],
      "shift-e": [
        "task::Spawn",
        {
          "task_name": "Org agenda: entry text mode, some text of each entry under its line"
        }
      ],
      "v shift-e": [
        "task::Spawn",
        {
          "task_name": "Org agenda: entry text mode, some text of each entry under its line"
        }
      ],
      "shift-f": [
        "task::Spawn",
        {
          "task_name": "Org agenda: follow mode, the cursor's entry in another window"
        }
      ],
      "m": [
        "task::Spawn",
        {
          "task_name": "Org agenda: mark the entry for a bulk action"
        }
      ],
      "u": [
        "task::Spawn",
        {
          "task_name": "Org agenda: unmark the entry"
        }
      ],
      "shift-u": [
        "task::Spawn",
        {
          "task_name": "Org agenda: unmark all entries"
        }
      ],
      "alt-m": [
        "task::Spawn",
        {
          "task_name": "Org agenda: toggle the mark of the entry"
        }
      ],
      "*": [
        "task::Spawn",
        {
          "task_name": "Org agenda: mark all entries"
        }
      ],
      "alt-*": [
        "task::Spawn",
        {
          "task_name": "Org agenda: toggle the marks of all entries"
        }
      ],
      "%": [
        "task::Spawn",
        {
          "task_name": "Org agenda: mark the entries matching a regexp"
        }
      ],
      "shift-b": [
        "task::Spawn",
        {
          "task_name": "Org agenda: an action on the marked entries"
        }
      ],
      "/": [
        "task::Spawn",
        {
          "task_name": "Org agenda: filter by tags, categories, effort and regexps"
        }
      ],
      "\\": [
        "task::Spawn",
        {
          "task_name": "Org agenda: filter by tag"
        }
      ],
      "<": [
        "task::Spawn",
        {
          "task_name": "Org agenda: filter by the line's category"
        }
      ],
      "=": [
        "task::Spawn",
        {
          "task_name": "Org agenda: filter by a regexp"
        }
      ],
      "_": [
        "task::Spawn",
        {
          "task_name": "Org agenda: filter by effort"
        }
      ],
      "^": [
        "task::Spawn",
        {
          "task_name": "Org agenda: filter by the line's top headline"
        }
      ],
      "|": [
        "task::Spawn",
        {
          "task_name": "Org agenda: remove all filters"
        }
      ],
      "v a": [
        "task::Spawn",
        {
          "task_name": "Org agenda: include archived trees"
        }
      ],
      "v shift-a": [
        "task::Spawn",
        {
          "task_name": "Org agenda: include archived trees and archive files"
        }
      ],
      "shift-i": [
        "task::Spawn",
        {
          "task_name": "Org agenda: Clock in"
        }
      ],
      "shift-o": [
        "task::Spawn",
        {
          "task_name": "Org agenda: Clock out"
        }
      ],
      "shift-x": [
        "task::Spawn",
        {
          "task_name": "Org agenda: Cancel the clock"
        }
      ],
      "t": [
        "task::Spawn",
        {
          "task_name": "Org agenda: Change the TODO state"
        }
      ],
      "+": [
        "task::Spawn",
        {
          "task_name": "Org agenda: Raise the priority"
        }
      ],
      "shift-up": [
        "task::Spawn",
        {
          "task_name": "Org agenda: Raise the priority"
        }
      ],
      "-": [
        "task::Spawn",
        {
          "task_name": "Org agenda: Lower the priority"
        }
      ],
      "shift-down": [
        "task::Spawn",
        {
          "task_name": "Org agenda: Lower the priority"
        }
      ],
      ",": [
        "task::Spawn",
        {
          "task_name": "Org agenda: Set the priority"
        }
      ],
      "ctrl-c ctrl-x p": [
        "task::Spawn",
        {
          "task_name": "Org agenda: Set a property of the entry"
        }
      ],
      "e": [
        "task::Spawn",
        {
          "task_name": "Org agenda: Set the effort of the entry"
        }
      ],
      "ctrl-c ctrl-w": [
        "task::Spawn",
        {
          "task_name": "Org agenda: Refile the entry"
        }
      ],
      "z": [
        "task::Spawn",
        {
          "task_name": "Org agenda: Add a note to the entry"
        }
      ],
      "ctrl-c ctrl-o": [
        "task::Spawn",
        {
          "task_name": "Org agenda: Open the link or thing at the cursor"
        }
      ],
      "$": [
        "task::Spawn",
        {
          "task_name": "Org agenda: Archive the subtree"
        }
      ],
      "ctrl-c ctrl-x ctrl-s": [
        "task::Spawn",
        {
          "task_name": "Org agenda: Archive the subtree"
        }
      ],
      "ctrl-c $": [
        "task::Spawn",
        {
          "task_name": "Org agenda: Archive the subtree"
        }
      ],
      "ctrl-c ctrl-x shift-a": [
        "task::Spawn",
        {
          "task_name": "Org agenda: Archive the subtree under its Archive sibling"
        }
      ],
      "ctrl-c ctrl-x a": [
        "task::Spawn",
        {
          "task_name": "Org agenda: Toggle the ARCHIVE tag"
        }
      ],
      "ctrl-c ctrl-x ctrl-a": [
        "task::Spawn",
        {
          "task_name": "Org agenda: Archive with the default command"
        }
      ],
      "a": [
        "task::Spawn",
        {
          "task_name": "Org agenda: Archive with the default command, once confirmed"
        }
      ],
      "shift-right": [
        "task::Spawn",
        {
          "task_name": "Org agenda: Move the date one day later"
        }
      ],
      "shift-left": [
        "task::Spawn",
        {
          "task_name": "Org agenda: Move the date one day earlier"
        }
      ],
      "ctrl-c ctrl-s": [
        "task::Spawn",
        {
          "task_name": "Org agenda: Schedule the entry"
        }
      ],
      "ctrl-c ctrl-d": [
        "task::Spawn",
        {
          "task_name": "Org agenda: Set the deadline of the entry"
        }
      ]
    }
  }
]
